{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make test)",
      "Bash(make typecheck)",
      "Bash(make check)",
      "Bash(make build)",
      "Bash(npm test)",
      "Bash(npm run test:watch)",
      "Bash(npm run build)",
      "Bash(npx tsc --noEmit)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*credential*)",
      "Read(./**/*secret*)"
    ]
  }
}
